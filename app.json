{
  "expo": {
    "name": "Nutrition Tracker",
    "slug": "nutrition-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/health/icon.png",
    "scheme": "nutritiontracker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/health/icon.png"
    },
    "android": {
      "package": "com.melindamalmgren.nutritiontracker",
      "adaptiveIcon": {
        "backgroundColor": "#E8EDDF",
        "foregroundImage": "./assets/health/adaptive-foreground.png",
        "monochromeImage": "./assets/health/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/health/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E8EDDF",
          "image": "./assets/health/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Nutrition Tracker to use the camera to scan food barcodes.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ec677598-abcf-4bd8-8b9e-ab2146e0aea8"
      }
    },
    "owner": "melindamalm"
  }
}
